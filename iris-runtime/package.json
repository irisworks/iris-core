{
	"name": "@iris-core/runtime",
	"version": "1.11.0",
	"description": "Iris runtime — always-on AI orchestrator that manages sub-agent fleets over Slack and Telegram",
	"type": "module",
	"bin": {
		"iris-runtime": "dist/main.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsc -p tsconfig.build.json && chmod +x dist/main.js",
		"dev": "tsc -p tsconfig.build.json --watch",
		"test": "node --test test/*.test.mjs",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@anthropic-ai/sandbox-runtime": "^0.0.16",
		"@earendil-works/pi-agent-core": "0.84.2",
		"@earendil-works/pi-ai": "0.84.2",
		"@earendil-works/pi-coding-agent": "0.84.2",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@silvia-odwyer/photon-node": "^0.3.4",
		"@sinclair/typebox": "^0.34.0",
		"@slack/socket-mode": "^2.0.0",
		"@slack/web-api": "^7.0.0",
		"ajv": "^8.18.0",
		"chalk": "^5.6.2",
		"croner": "^9.1.0",
		"diff": "^8.0.2",
		"dotenv": "^16.0.0",
		"file-type": "^21.3.4",
		"qrcode-terminal": "^0.12.0",
		"ws": "^8.21.3"
	},
	"overrides": {
		"axios": "^1.19.0",
		"form-data": "^4.0.6"
	},
	"devDependencies": {
		"@types/diff": "^7.0.2",
		"@types/node": "^24.3.0",
		"@types/qrcode-terminal": "^0.12.2",
		"@types/ws": "^8.5.13",
		"typescript": "^5.7.3"
	},
	"keywords": [
		"slack",
		"bot",
		"ai",
		"agent",
		"iris"
	],
	"author": "Iris Core Contributors",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/irisworks/iris-core.git",
		"directory": "iris-runtime"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
